{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexPass",
  "version": "7.0.1",
  "identifier": "com.nexapp.nexpass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexPass",
        "width": 420,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NexApp",
    "copyright": "© 2026 NexApp — Developed by Arabi Islam, MR. ARX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["com.googleusercontent.apps.625887113006-1ltgg1u1dkec1vhehs5ut80fiurhk7de"]
        }
      ]
    }
  }
}
