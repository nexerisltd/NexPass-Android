// Copy this file to src-tauri/src/secrets.rs (git-ignored, never commit
// it) and fill in real values, OR let CI generate it from GitHub
// Secrets (see .github/workflows/android-signed-apk.yml).

// The Android-type OAuth client used for Google Sign-In on-device.
// Android clients have NO client secret in Google Cloud Console (the
// app is verified by package name + release-keystore SHA-1 instead) —
// see google_auth.rs for the PKCE + custom-scheme-redirect flow this
// enables.
pub const GOOGLE_CLIENT_ID: &str = "625887113006-1ltgg1u1dkec1vhehs5ut80fiurhk7de.apps.googleusercontent.com";

// Only read by the desktop-loopback sign-in path (kept for local dev on
// a non-Android target); the Android build never touches it. Leave
// blank if you only ever build for Android.
pub const GOOGLE_CLIENT_SECRET: &str = "";

pub const FIREBASE_API_KEY: &str = "YOUR_FIREBASE_API_KEY";
